# Set to "true" to expose Arabic (/ar routes + language toggle). Build-time flag: redeploy after changing.
NEXT_PUBLIC_ENABLE_ARABIC=false

# Temporary: when set, "Assess Your Risk" CTAs (header + homepage) become a mailto: link to this address.
# Unset it to route to the /assess-risk form again. Build-time flag: redeploy after changing.
# NEXT_PUBLIC_ASSESS_RISK_MAILTO=busdev.specialist@britamarabia.com

# Form recipients (server-side only)
# HR_INFO_EMAIL=        # homepage "Make an Inquiry" form
# HR_BUSINESS_EMAIL=    # contact-us page form (falls back to HR_INFO_EMAIL if unset)
# HR_CAREERS_EMAIL=     # careers applications + assess-risk form
