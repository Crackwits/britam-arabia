# Set to "true" to expose Arabic (/ar routes + language toggle). Build-time flag: redeploy after changing.
NEXT_PUBLIC_ENABLE_ARABIC=false

# Form recipients (server-side only)
# HR_INFO_EMAIL=        # homepage "Make an Inquiry" form
# HR_BUSINESS_EMAIL=    # contact-us page form + assess-risk form (falls back to HR_INFO_EMAIL if unset)
# HR_CAREERS_EMAIL=     # careers applications

# Microsoft Graph mail sending (server-side only) — Entra app registration with the
# Mail.Send application permission (plus Mail.ReadWrite for attachments over 3MB)
# MS_TENANT_ID=         # Directory (tenant) ID
# MS_CLIENT_ID=         # Application (client) ID
# MS_CLIENT_SECRET=     # client secret value
# MS_SENDER=            # mailbox the forms send from, e.g. busdev@britamarabia.com

# HubSpot (server-side only) — Service Key for the inquiry, contact and assess-risk forms.
# Scopes: crm.objects.contacts.read/write, crm.objects.companies.read/write,
# crm.objects.deals.read/write, crm.schemas.deals.write.
# Run `node --env-file=.env.local scripts/hubspot-setup.mjs` once.
# HUBSPOT_ACCESS_TOKEN= # pat-...

# Public site origin — used for canonical URLs, hreflang and the og:image fallback (/og/default.png).
# Build-time: redeploy after changing. Must be the frontend domain, NOT the Strapi URL.
NEXT_PUBLIC_SITE_URL=https://www.britamarabia.com
NEXT_PUBLIC_SITE_NAME=Britam Arabia
